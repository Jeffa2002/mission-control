[Unit]
Description=Mission Control token usage aggregator
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/mission-control
Environment=AGENT_DATA_DIR=/root/.openclaw/agents
Environment=USAGE_TELEMETRY_OUTPUT=/root/.openclaw/workspace/mission-control/runtime/token-usage.json
ExecStart=/usr/bin/node --experimental-strip-types /root/.openclaw/workspace/mission-control/apps/panel/src/app/api/usage/usage-writer.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/.openclaw/workspace/mission-control/runtime

[Install]
WantedBy=multi-user.target
